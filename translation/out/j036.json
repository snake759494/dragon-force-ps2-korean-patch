{
 "d6d6aec0bf70": "나의 기사단이\n네놈들을 상대해 주마!",
 "9fdcacd1c315": "사단장 공에겐 미안하지만\n내가 먼저 나가겠다!",
 "b82498882499": "그럼, 다녀오겠다!",
 "5d15a5a0ae49": "알았다. 동행하지.",
 "accc427fb9fc": "그런가, 알았다.",
 "8f242a88467e": "혼자 온 용기는 인정하지만,\n좀 무모했군.",
 "8fb98e203112": "모두, 말살.",
 "11a32ed09608": "...제가.",
 "1a96bd0be14c": "어서...",
 "852ee1e11870": "안 됩니다...",
 "9596db2fa000": "안 돼...",
 "e7387caca3ba": "싫어...",
 "6e38b8f85244": "좋습니다...",
 "bdd3d93f81b3": "알겠습니다...",
 "163587cf1684": "가...",
 "770b2932442b": "가거라...",
 "45d844ac0a00": "...그럼.",
 "4885086a8ded": "휴...",
 "9377b04612f1": "물러나겠습니다...",
 "d043f2fb88a1": "물러납니다...",
 "715a9a96602a": "...묵사발로 만드세요.",
 "ea7d6a788196": "죽음을 서두르는가?\n어리석은 놈들!",
 "52c80ed4e398": "소인이 나가겠소.",
 "fea552a208e4": "맡기겠다.\n실패는 용서치 않는다.",
 "d1ca68691b2d": "그대에겐 맡길 수 없소.",
 "6f3ffbed2587": "소인이 나설 것까지는\n없겠지.",
 "58f0b58e955e": "알겠소이다.",
 "e0758d766cad": "안 된다. 허락할 수 없다.",
 "93bacf41b202": "그럼, 실례하겠소.",
 "b73add1ee7d8": "나중에 후회해도 난 모른다.",
 "dae9740c5da5": "피의 제물로 삼아라!!",
 "ac2b735389a7": "지금이라면 용서해 주지\n못할 것도 없다.",
 "85b26a309f87": "벌써 끝인가?",
 "4f9eaca7646c": "...이, 이 내가\n불각을 취하다니.",
 "fc63023ac8f3": "다음엔 이렇게 안 될 거다.",
 "60b006f503b6": "대화에 응해 주지\n않겠나?",
 "620bced3d084": "어리석은 놈!",
 "7ec9a3d4e54b": "혼자 오다니...\n죽어라!",
 "01f1c5528514": "처단하겠다!",
 "6c2d48982e8a": "처단하겠소!",
 "6816a856fdf1": "죽고 싶지 않다면\n당장 도망치는 게 좋을 거다.",
 "ee2756e30642": "이번엔 소인에게 선봉을\n명해 주시오.",
 "13a2d50f7157": "이번엔 꼭 소인에게.",
 "4883955973c4": "그렇군. 맡기겠다.",
 "6b5d79b5aad6": "잘 부탁한다.",
 "01882fb9b7e2": "이번엔 참아 다오.",
 "7f83d99111e9": "그대는 안 되오.",
 "0bc2f21f8dbf": "소인, 이번 작전에서는\n빠지겠소.",
 "8662935bbea5": "의욕이 나지 않는군.",
 "be08a6fa48c0": "그런 것 같군.\n쉬고 계시오.",
 "1a8e9b4d3da9": "알았다.\n대기하고 있어라.",
 "c7b0892e2a42": "안 된다. 꼭\n나가 주어야겠다.",
 "e33eafd48e3c": "이 무슨 한심한 소리. 허나,\n허나 이번엔 부탁하오.",
 "b1203ffc0992": "그럼, 곧바로 출진하겠소.",
 "8356e5333a5c": "그런 사정이라면\n어쩔 수 없군. 대기하겠다.",
 "e4cd4f90e245": "그런가, 그럼 어쩔 수 없지.\n나가 볼까.",
 "2f8f11f12dcb": "나의 인술 앞에\n적은 없다!",
 "a0570d8ef9a2": "네놈의 목은\n소인이 가져간다!",
 "7f413f7c705a": "간다!!",
 "205fccc894c3": "이겼군.",
 "79a4fd28fa9d": "철수!",
 "83a9c857f8e7": "싸우는 건 상책이 아니겠지.\n여기선 대화하지 않겠나.",
 "7f82dba6cca0": "이러고 있어 봐야 소용없다.\n여기선 손을 잡지 않겠나.",
 "f9f48c27f92c": "그대 말대로군.\n알았다. 협력하지.",
 "e1edb4c394b1": "여기서의 다툼은 피하고 싶소.\n실례하겠소.",
 "505eb6eb0140": "주군을 배신할 순 없다.\n교섭 결렬이군.",
 "6d12e6b2d040": "화가 났다. 죽인다.",
 "215d723cacdf": "소인은 그런 짓은\n하지 않는다.",
 "32270c30e1b8": "닌자의 체면을 걸고\n너를 베겠다.",
 "e55e2cdb81e8": "미안하지만 사라져 줘야겠다.",
 "73b42b90c670": "정정당당히 승부하겠소.",
 "15c2bedbcbdf": "이번엔 소인이 출진하겠소.",
 "61fd44ef673b": "선진은 소인에게 맡겨 주시오.",
 "a174260c21a8": "알겠소이다.\n조심하시오.",
 "4c06eda74783": "그대에겐 무리요.\n여기서 기다리시오.",
 "6de43da94fba": "그대는 상대가 안 되오.\n잠시 기다리시오.",
 "27065e173e8e": "소인, 아직 미숙하여\n전투는 무리이옵니다.",
 "a3dafbb3d621": "소인의 실력으로는\n당해 낼 수 없사옵니다.",
 "ffd56a79eed3": "알겠소이다.\n여기선 쉬시오.",
 "1d9b26ed3095": "음, 잘 알았소.\n대기해 주시오.",
 "24329a2108ca": "이번만은 꼭 그대가\n출격해 주어야겠소.",
 "f559b3d56427": "무슨 말씀이오!\n적이 눈앞에 있사옵니다.",
 "39cc3e509399": "무사의 영예이옵니다.",
 "32cd23c004c2": "어쩔 수 없군.\n기다리겠사옵니다.",
 "0027322dabd9": "면목 없사옵니다.\n다음엔 반드시.",
 "8ee5433058ef": "그렇사옵니까. 그럼\n어쩔 수 없지. 출진하겠소.",
 "7844a0449ebb": "나의 검의 날카로움,\n똑똑히 보시오!",
 "ba752133e90f": "소인의 인술 앞에\n적은 없다...",
 "7f79e2c49e6a": "그 정도 실력으로는\n소인을 벨 수 없다!",
 "f2fba05f8ceb": "이런 낭패가.",
 "3c89e818e685": "수행이\n부족했군...",
 "16733b7d344c": "그대도 싸울 때가\n아니지 않소. 소인과 가세.",
 "bfc69e13c86b": "그대, 쓸 만하군.\n어떤가, 오지 않겠나.",
 "dc347c3625a9": "말씀은 알겠소이다.\n여기선 그대를 따르겠소.",
 "efeae3c7afea": "여기선 서로 물러나는 편이\n좋을 것 같사옵니다.",
 "4c3dadfcc9f2": "아쉽지만 소인과 그대는\n맞지 않는 것 같사옵니다.",
 "f5be05ceaa6e": "고마운 말씀이오나\n거절하겠사옵니다.",
 "f67a0d4b0a77": "소인은 그런 비겁한 짓은\n할 수 없사옵니다.",
 "c77ffe70b1be": "두 번 다시 일어서지 못하게\n혼내 줄게.",
 "0290b82a40d1": "나를 만난 걸\n후회하게 해 줄게.",
 "a8befeddfe7d": "저에게 맡겨 주세요.",
 "7ca7df12137e": "제가 하게 해 주세요.",
 "f0f076684044": "힘내세요.",
 "01eda6de9b9a": "멋대로 말하지 말아\n주시겠어요?",
 "cc1d9a60cee6": "잠깐 조용히 해\n주세요.",
 "3718b3fdcff0": "싸울 마음이 안 나요.",
 "6f9faf854712": "제 실력으로는 도저히\n무리예요.",
 "2ef99488628e": "이런 겁쟁이, 데려오지\n말 걸 그랬어.",
 "f21ff5f7f1b5": "이제 와서 무슨.\n정말...",
 "b884f4494347": "그건 좀\n곤란한데요...",
 "c1a8532a05c6": "말 좀 들어!",
 "5c45e05fe9e3": "지켜봐 주세요.",
 "5fd541cccc5a": "저를 믿지\n않으시는군요...",
 "edd2fa0b68a0": "간다, 가요, 가면\n되는 거잖아!",
 "f6d00452f6d8": "두 번 다시 덤비지 못하게\n본때를 보여 주고 올게요.",
 "a75b6f900b55": "마음껏 날뛰고 올게요.",
 "86ced584606f": "이제 사과해도\n용서 안 할 거예요.",
 "c330f5472125": "해냈다!\n식은 죽 먹기!",
 "1a54411ced22": "철수할 거야!",
 "52db0e0c024e": "나쁘게는 안 할 테니\n얌전히 투항해.",
 "136925441bc5": "당신, 그렇게 나쁜 사람으론\n안 보이니까 사이좋게 지내자.",
 "3d0caa203771": "알았어, 동료가\n되자.",
 "eabe4b667e5a": "교섭 결렬이네.\n서로 물러나자.",
 "6094f1b2d951": "시끄러워. 어떻게 하든\n내 맘이잖아.",
 "41e3b1a43f60": "후훗, 잘 왔어.\n죽어 줘야겠어.",
 "a2c85c9feaaa": "철저하게 박살 낸다!",
 "2e5e5152ca69": "유언이 있으면\n내가 들어 주지.",
 "fa78bba553e9": "죽어도 좋은 놈은\n덤벼라!",
 "f74fe16d1333": "내가 먼저다. 괜찮지?",
 "a472bbc22d23": "여긴 나한테 맡겨 줘.",
 "e02e7b47d12e": "그래, 좋아.\n맘대로 해.",
 "666037e7c71a": "그래, 당신한테 맡기는 게\n낫겠어.",
 "375b6c9aa880": "그건 봐줘.",
 "dbce360f8a03": "글쎄...\n안 돼.",
 "c90988a2ee56": "좀 봐줘. 응?",
 "2a13c5dc005b": "쉬겠다.",
 "59dddb1bbe91": "오오, 그런가. 무리한 부탁을\n해서 미안했다.",
 "5175817dfc9c": "뭐, 맘대로 해.",
 "6dfede53a0ad": "내 말을\n못 듣겠다는 거냐.",
 "405b64fcee6a": "무리인 건 알고 있다.\n부탁한다.",
 "4f238edb884e": "맡겨 줘!",
 "c9b8d35fa013": "아, 그래. 알았다고.",
 "3ee27b0dce2e": "미안하군.",
 "91e403592d42": "이 몸을 이길 수 있을까?",
 "bcc24aa5c82c": "내 주먹이 불타오른다!",
 "29680dc80a8b": "어쩔 수 없지.\n상대해 주마!!",
 "31db1534d058": "좋았어!!",
 "a5437fdb7633": "철수...",
 "e614dfe1ccac": "내 편에 붙어. 알았지.",
 "9ef54fcc3554": "어이, 우리랑 손잡지 않을래?",
 "b9167020d623": "잘 알았다.\n좋아, 동료가 되지.",
 "062295fb3497": "싸워도 되지만, 여기선\n서로 물러날까.",
 "6d54dbe52370": "싫다.\n교섭 결렬이군.",
 "992aa9e9bdf8": "당신과는 생각이 달라.\n거절하지.",
 "d7a506745d21": "배짱만은 인정하마.\n죽어라.",
 "9474fd199e18": "목숨이 아깝지 않다면\n상대해 주지.",
 "1c3d479e18fa": "네놈보다 강한 자가 있다는\n걸 가르쳐 주마.",
 "93421aa2a953": "도망치지 않은 배짱만은\n인정해 주마.",
 "6351b10511eb": "우선 소인이 가겠소.\n괜찮겠소?",
 "d73e0545b37a": "소인이 가겠소.\n이견은 없겠지?",
 "445329403517": "의욕은 알겠다.\n다녀와라.",
 "8146135a6f3f": "흠...\n좋겠지.",
 "ce538268bb9a": "네 실력을 생각해 봐라.",
 "8b280ac500bc": "선진에 서겠다니\n10년은 이르다!",
 "7aafb38721c1": "소인이 나설 자리는 아니겠지.",
 "1b1aff7c53bc": "싫다고 하면\n어쩔 텐가?",
 "6f1cc182f7c5": "그런가. 그렇게 해라.",
 "88a398350b98": "음, 어쩔 수 없군.",
 "0085eb6045bb": "이제 와서 그런 약한 소리를\n해서 어쩌자는 거냐!",
 "25e1d9ba913e": "잠자코 다녀와라.",
 "c2502b9c1300": "음, 그럼 바로 준비를.",
 "7cbafd6d2bb9": "미안하군.",
 "905b23b5e180": "소인의 앞을 가로막는 자는\n누구든 벤다...",
 "9712b3b3762c": "실력이 어느 정도인지 모르나\n소인의 적은 아니겠지.",
 "f8e21078f562": "꽤 실력이 있는 모양이군.\n소인이 상대하지.",
 "21cdf9471f8c": "소인의 상대가 아니었군.",
 "dfa6871f99b9": "철수한다!",
 "bcf833e1e08f": "죽이지는 않겠다. 소인을\n따라와라.",
 "a226b0426ede": "무리인 줄 아는 부탁이오.\n소인과 함께 싸우지 않겠소.",
 "aa8dba2b9ed6": "알았다. 네게 힘을\n빌려주지.",
 "95f280213408": "여기서 칼을 맞대 봐야\n공멸할 뿐. 물러나자.",
 "301337fd5785": "말이 안 통하는군. 거절한다!",
 "8b93eb90626a": "됐다, 말이 안 통한다.",
 "54e06e9f1449": "가능하면 이런 일은\n하고 싶지 않았다.",
 "9f31bd7e5091": "약해 보여서 안심했어.",
 "95fd32236e83": "다리가 풀려 못 서게\n해 줄게.",
 "6f1c29aecb74": "이제 끝이야.\n각오해.",
 "e5af7886f329": "이번엔 제가\n하게 해 주세요.",
 "a2b24e80af25": "제가 먼저 싸우게 해 줘요.\n이길 것 같은 기분이 들어요.",
 "e8d1db202037": "알겠습니다.\n잘 부탁드려요.",
 "c48586654f18": "그렇군요.\n잘 부탁드려요.",
 "de02bfd6399b": "자기 실력을 생각해\n주세요.",
 "e0eb8e853897": "멋대로 말하지 말아\n주세요.",
 "5a577ce828ef": "제 부대는 적과\n상성이 나쁜데요.",
 "ece14747e517": "병사가 너무 적어서\n싸움이 안 돼요.",
 "e453e3c9ea35": "...그렇군요,\n알겠습니다. 허락할게요.",
 "d5c5e936db52": "당신이 그렇게 말한다면\n어쩔 수 없네요.",
 "6c5e5a4fa3d1": "안 돼요! 가 주세요.",
 "e1ee9b73d3b3": "힘내세요.",
 "f4c837e804fb": "힘낼게요.",
 "5248bd1fd83e": "정말 죄송해요.",
 "18ea92920ab7": "...원망할 거예요.",
 "1a549334ec63": "박살 내 드리죠.",
 "d94bf617f808": "맡겨 줘.",
 "86739774ffc5": "결판은 내가 낸다!",
 "2f38c254d5d2": "해냈다!",
 "e49d2e0926e2": "도망쳐!",
 "2cd9c4e7c6ab": "동료가 되어\n주셨으면 하는데요.",
 "0db5eb2b2642": "지금 당신의 힘이\n필요해요.",
 "8573e57e3b3b": "알겠습니다.\n저를 써 주세요.",
 "0181e17320eb": "말씀은 알겠어요.\n하지만 싫어요.",
 "d7e201b3a7ca": "그런 제안은 거절이에요.",
 "a227896c7367": "그런 말에 내가\n넘어갈 것 같아?",
 "65a27a8e117a": "마음에 안 드네.\n묵사발이야.",
 "b66d092bed76": "한 명도 남김없이 숨통을\n끊어 줄게.",
 "33d9cf4cdc92": "나한테 덤비면\n어떻게 되는지 알려 줄게.",
 "427b04872733": "너희들 강해 보이네.\n할 맛 나겠어.",
 "6d1e56b1ee9c": "나한테 맡겨.",
 "2402b288115e": "나 보내 줘. 응!",
 "c50a39651c5b": "그래, 가든지.",
 "34fc2d58fc6b": "해 볼 만큼 해 보든지.",
 "0a686f8c0c06": "안 돼.",
 "27fab7ab0050": "싫어.",
 "ed7217615351": "오늘은 싸우기 싫어.",
 "ab2b4ed0aa66": "아플 것 같으니까 싫어.",
 "81ef7d85d807": "그럼 그만두든지.",
 "283c1ebfab91": "좋아.",
 "ff2685f187dc": "안 돼. 용서 안 해.",
 "93015d9b1aad": "안 해 주면 싫어.",
 "4e9ded6469f7": "야호!",
 "34c52de221a5": "그래. 그럼 관둘래.",
 "4f4e94760241": "하면 되잖아!",
 "af011e09133c": "나를 이길 수 있을 것 같아?",
 "7828617e9304": "봐주지 않을 거야!",
 "61faac83919e": "식은 죽 먹기!",
 "ced84ed79f09": "철수할 거야!",
 "c1753b8b3131": "후후, 사이좋게 지내자!",
 "5525ff8d9127": "부탁이야! 나랑 함께\n싸워 줘.",
 "1429ee282717": "잘 부탁해. 사이좋게 지내.",
 "10e5590706e5": "거절이야. 하지만 싸우는 건\n싫으니까, 바이바이.",
 "198461e98857": "갑자기 그런 말 해도\nOK할 수 있을 리 없잖아.",
 "aa0c0b3c38fc": "확실히 대답해 드리죠.\n싫어.",
 "40eb57c4669d": "혼자 오다니, 기특해라.\n하지만 묵사발이야.",
 "0f7d6089fff7": "지옥에 떨어져라...",
 "5bf616d69cb8": "지옥에 떨어지거라...",
 "57e4b50fbd78": "골다크여, 용서 못 한다.\n지옥에 떨어져라...",
 "37a3c2e364e6": "뭐어어어어어어...",
 "3d39c2f4af61": "우리가 상대해 주지.",
 "46b21aef23d3": "다치기 싫으면\n썩 꺼져라!!",
 "bb55b85bd280": "나한테 맡겨!",
 "d0c95362d6d1": "이 ⟦V 00⟧ 님이\n본때를 보여 주마!",
 "86afa01b367c": "그래, 마음껏\n하고 와라!",
 "8afadb3ab37e": "할 거면\n철저하게 해라.",
 "0fbc693f26ef": "아니, 너를 보낼\n수는 없다.",
 "f792b400cb55": "네가 당할 상대가 아니다.\n여기선 물러나 있어라.",
 "e5ce29186dcc": "이 나더러 죽으라는\n겁니까요...",
 "939593b34225": "미안하지만 이번만큼은\n상대가 나빠...",
 "0a3e8539a2bd": "쳇, 어쩔 수 없군.\n어떻게 한다.",
 "77f5581a1aa2": "뭐, 여기서 무리할 것도\n없나...",
 "35d81f9a227a": "잠자코 다녀와!",
 "24731c07576a": "어쩔 수 없다,\n이해해 줘.",
 "711617d16267": "그럼\n다녀오마!",
 "3a658abeb94d": "흥, 이 몸도\n얕보였군.",
 "de067930d867": "미안하군.",
 "3d359ea4b971": "정말이지, 사람을\n험하게 부려 먹는군.",
 "8201c43ad6cf": "이 승부, 내가 가져간다!",
 "6a31570499f4": "이 ⟦V 00⟧ 님을\n얕보면 곤란하지!",
 "47f526baa07d": "식은 죽 먹기다!",
 "8ec7928525bc": "어때,\n내 부대에 들어오지 않을래?",
 "56672a8d34f9": "흥, 당신 마음에 들었어.\n나를 따라와.",
 "7c4c03728e0f": "미안하지만 두목은 배신 못 해.\n또 보자.",
 "aea523c08986": "믿을 수가 없군.\n난 간다.",
 "c052a58d02ab": "말은 알았다. 하지만\n사는 세계가 달라.",
 "a4b40dc5e699": "얘들아,\n해치워라!",
 "f019c3cb148b": "우후후. 나와 한판\n붙으실 생각인가요?",
 "acdc0123a198": "나를 이길 수 있을 것 같아?\n어림없어.",
 "b1a04dd70b33": "악몽을 보여, 줄, 게\n우후후.",
 "0e37ac078086": "내가 해도\n괜찮을까?",
 "431939a46056": "내가 갈게.\n괜찮겠지?",
 "7bf1188fa2ab": "그래, 좋아요.",
 "2337c288d3e7": "힘내렴.",
 "edc3c73842ba": "우후후. 당신으론\n안 돼. 물러나!",
 "25cf0574f7f5": "분수를 아는 게\n어떨까?",
 "d71db1020d17": "난 여기서 보고 있을게.\n당신이 가면 어때?",
 "2fbaad3b8ac8": "어머, 난 싸울 생각 없어.\n다른 사람한테 부탁하지?",
 "236a23355476": "그래.\n딱히 상관없어.",
 "143fefebc30c": "그런 걸 내가 허락할 것\n같아? 가렴.",
 "1d52a85c59be": "나중에 즐거운 걸 해 줄 테니\n힘내렴.",
 "7cb5a932052c": "그럼, 다녀올게.",
 "a12b188b831b": "어머, 그래.\n흥이 깨지네.",
 "dc52194bc03d": "우후후. 고마워.",
 "9b801ebb4cf2": "어머, 허락해 주지 않는구나.\n좋아, 해 볼게.",
 "8b6f2e92a0c0": "그런 흔한 정령사와\n똑같이 보지 말아 줘.",
 "9e595417e45a": "어떤 마법이 취향이야?\n간다!",
 "59e630ae9abb": "우후후.\n덤벼 보렴.",
 "b8dccb519633": "어머, 아직 있었어?\n다시 오렴.",
 "b8afd0cc0e35": "......\n방심했네.",
 "af04124c6d27": "물러나겠어요.\n또 만나요.",
 "1ce650741af9": "나와 함께 가지 않을래?\n나쁘지 않을 거야.",
 "183273a40169": "거절하겠어.\n물러나 주시겠어요?",
 "4d4d5e2bc89c": "어머, 교섭 따위가 통할 줄\n알았어? 싫어.",
 "b5aa193ce654": "악몽을 보여 줄게.\n묵사발 나는 악몽을!",
 "c57c9ab637d6": "전장에서 정은 필요 없다.\n간다!!",
 "10a7212870c8": "그 정도 병력으로는\n우리를 절대 이길 수 없다!",
 "d6236d2f5c29": "여기는 나에게\n맡겨 주게.",
 "43ca13fa50fd": "내가 먼저 돌격해도\n괜찮겠나?",
 "2520219f7b6c": "그런가. 알았다.\n자네에게 부탁하지.",
 "76fe77e9cd73": "그런가, 해 주겠나.\n이쪽도 도움이 된다.",
 "831e63c6f752": "전장에서는 사령관인\n나의 지시를 따르게.",
 "b87c7ae532a4": "작전에 지장이 생긴다.\n그런 발언은 삼가 주게.",
 "59d13e436b43": "부탁한다. 이번만은\n빠지게 해 주지 않겠나.",
 "fe5f8d4751ad": "놈들과 싸울 의리는 없다.",
 "fc93c5657725": "알았다. 마음대로 하게.",
 "964cee4a4eaf": "어쩔 수 없군. 다른 이를 찾지.",
 "76d1ec9a2775": "명령 거부는 절대 용납 못 한다.",
 "6ce36acaeb92": "부탁한다. 가 주게.",
 "e7c02b197fb5": "억지를 부려서\n미안하군.",
 "749cbcfaa0e2": "이해해 주지 않다니\n유감이군.",
 "cd948213a208": "정말 미안하다.",
 "8d89b95c3358": "그런가. 알았다.\n어쩔 수 없지.",
 "2a4dc8f0d0e9": "그럼 맡겨 주게.",
 "247a8a96118f": "저 정도 부대는\n내 적이 아니다.",
 "a689055fd32a": "봐주지 않겠다.\n각오해라.",
 "6b7b6efd4ce0": "승부는 난 것 같군.\n우리의 승리다.",
 "f29b6d6f2b2b": "퇴각한다!",
 "95b8d88dce88": "쓸데없는 전투는 피하고 싶다.\n여기선 교섭하자.",
 "2a1a96a2ba7f": "역전의 용사인 듯하군.\n나와 손잡지 않겠나?",
 "6fcf216db077": "자네의 생각은 이해했다.\n알았다. 협력하지.",
 "e461c62a4a8b": "싸워 봐야 소용없지.\n여기선 검을 거두자.",
 "7992f2166a97": "자네와 나는 짊어진 것이\n다르다. 거절하겠다.",
 "f7b5da85dcc1": "판다리아의 기사로서\n그 말은 받아들일 수 없다.",
 "61548c328757": "덫에 걸린 모양이군.\n죽어라.",
 "f4275142e20f": "조금 벌이\n필요한 것 같네.",
 "4e2b82fc76f8": "오호호호호호.",
 "e9dd139c7a09": "호호호호호호.",
 "c23c672ee52e": "내가 나설 차례인가?",
 "fda94c34c64a": "해치워 버려!",
 "9d078400fa2f": "해치워 버려어!",
 "e41057ba65b0": "그런 제멋대로인 건\n용서 못 해.",
 "5e585748b269": "너희끼리 멋대로 하지그래?\n난 보고 있을 테니.",
 "42854f0f8e1a": "여왕에게는 휴식이\n필요하단다.",
 "4806481e3532": "좋아. 그 대신\n나중에 벌이야!",
 "42a3be2c9bfc": "칠칠치 못하긴,\n정말!!",
 "4907cd5ad6a2": "이러쿵저러쿵 떠들면\n여기서 벌이야!!",
 "3dfd29278929": "호호호호호.\n당연하지.",
 "8cd363d5361e": "나중에 두고 봐!",
 "56cc219a826d": "여왕에 대한\n당연한 행동이지.",
 "11b6bac2a11a": "호호호호호호.\n덤벼 보렴!",
 "f152222b926f": "무릎 꿇어라!",
 "6f08666ce6d5": "벌이 필요한 것 같네.",
 "d55abf218f21": "호호호호호호.\n다시 오렴!",
 "70219a1a9418": "끼이이이익!\n분해!",
 "d7cce8a9bfff": "두고 봐!",
 "20f66d283309": "친위대에 넣어 줘도\n괜찮아.",
 "dd197c610035": "당신 장래성이 있네.\n친위대에 들어와!",
 "a0901ab8dfb9": "좋아.\n오호호호호호.",
 "4da2f3b96539": "상대해 줄 만큼\n한가하지 않아.",
 "0686cb49ac83": "누구한테 그런 말을\n하는 거지?",
 "f90ab6203730": "유감이네. 나한테 교섭은\n안 통해.",
 "4ca56ceb4ab1": "혼자 오다니,\n바보 아냐, 당신?",
 "6dfc54731fcb": "자 그럼, 전투 개시\n해 볼까!!",
 "33db8e38a117": "무슨 일이 있어도 이긴다!!",
 "7cb832955fb8": "한 놈도 남김없이\n때려눕혀 주마!!",
 "e77a2b531168": "놈들에게 이 단련된\n육체를 보여 주고 오지.",
 "b38f44a52f9d": "여긴 이 육체파인\n나한테 맡겨.",
 "97a1e4f3d65c": "좋아, 잘 말했다.\n한 방 먹이고 와라!",
 "bba3b32df7c1": "좋아, 화끈하게 하고 와.",
 "a38e0d8194c2": "너 같은 나약한 놈에게\n선진은 맡길 수 없다.",
 "65776e17b781": "그런 소린 좀 더\n단련하고 나서 해라.",
 "d3c0643f60fc": "오늘은 피부 윤기가 별로라\n쉬겠습니다.",
 "ac013a6d75a3": "저런 상대로는 의욕이\n안 나. 쉴래.",
 "80f657a94bcc": "정말, 할 수 없군.\n뭐, 됐어.",
 "99fd12c02682": "또냐, 정말이지\n적당히 좀 해라.",
 "20d21dbfc17a": "근성이란 게 없냐,\n너는. 다녀와!",
 "331d33ea4b76": "제발 부탁이니까, 해 줘.",
 "715eba77bb9a": "고맙다. 그럼\n사양 않고 쉬겠어.",
 "8f360c3a295e": "어쩔 수 없지. 간다고,\n가면 되잖아.",
 "e14c666e5d9a": "몸이 근질거리는군!",
 "fa9dd1eff81f": "네놈 따윈\n한 팔로 해치워 주마!",
 "c6c88d0a69c4": "각오는 됐냐?\n간다!",
 "b2b9bef88373": "또 이겼다.",
 "be6d43eed092": "크윽......",
 "d06b831bbc60": "어때, 나랑 함께\n즐겁게 해 볼 생각 없나?",
 "f3d746d61eeb": "어때, 함께 가면\n나처럼 될 수 있다고.",
 "fc4d51fdd345": "너 같은 나약한 놈과는\n어울릴 수 없다. 잘 있어라.",
 "02fc2deb1532": "너 같은 놈하곤\n말이 안 통해. 거절이다!",
 "a63bc342c7ae": "잘 왔군.\n그럼... 포위해라.",
 "dcc9112912a4": "처음에 말해 두지만,\n저는 봐주지 않을 거예요.",
 "086789c98178": "오늘 난 기분이 나빠.\n도망치는 게 좋지 않을까?",
 "526614305523": "저는 봐주지 않아요.\n도망치는 게 좋지 않을까요?",
 "4f305fcc843f": "선진은 제 부대에\n맡겨 주시지 않겠어요?",
 "183e30cf200f": "우선 제 부대가\n선봉을 맡고 싶은데요.",
 "1c20de42bf49": "알겠습니다. 당신에게\n맡길게요.",
 "5d9ecf9c27b1": "그게 좋겠네요.\n힘내세요.",
 "ca26103c74dd": "사령관은 저예요.\n멋대로 말하지 마세요.",
 "8857af5b817f": "죄송해요. 이번엔\n참아 주세요.",
 "bf7f0e2c934b": "제 부대는 지금\n싸울 상황이 아니라서...",
 "a2790c672280": "이 전투는 지금의 저로선\n무리가 아닐까요...",
 "d49e41795faf": "무리한 말을 해서 죄송해요.\n푹 쉬세요.",
 "4150c5c1b997": "그럼 다음 전투에 대비해\n충분히 쉬어 두세요.",
 "5951e2985217": "지금 상황에서\n전투 회피는 용납 못 해요!",
 "e51428f952ba": "지원은 할 테니까\n이번엔 참아 주세요.",
 "152e3acb8a11": "네, 기대하며 지켜봐\n주세요.",
 "340b32d31b0e": "정말 죄송해요.\n나머진 잘 부탁드려요.",
 "1d8947a2a5ab": "하아, 그래요?\n그럼 어쩔 수 없네요.",
 "f5108c4c0578": "정말, 용서 안 할 거야!",
 "5c97d6baf43c": "승부야!",
 "8672947f4e43": "자, 승부해요!",
 "b21916f69321": "어머, 또 이겨 버린\n것 같네요.",
 "ccfdad4d001e": "그, 그럴 수가...",
 "ba73aeed8f73": "여기선 물러나죠.",
 "1168c0af88e6": "저와 동맹을 맺지 않겠어요?",
 "6d7a0e5a6884": "말씀은 알겠어요.\n당신과 함께 가겠습니다.",
 "7d768ea4b3b9": "전투만은 피하고 싶으니\n여기선 서로 물러나죠.",
 "ea5d0efdd958": "무슨 안이한 소리를...\n거절하겠습니다.",
 "754fb5775479": "이 이야기는 없던 걸로\n하죠.",
 "55fabfabece5": "가능하면 이런 일은\n하고 싶지 않은데요.",
 "7f7c9f9cbc70": "훈장을 목표로\n힘내자!",
 "c969ad5b157a": "왠지 짜증 나니까\n내가 갈게요!",
 "26422577ce93": "어, 정말 해 주는 거야!\n살았다.",
 "2b45723d089b": "너라면 해낼 것 같으니\n여긴 맡길게.",
 "3f2d71a96ef9": "작전 참모는 나라고.\n멋대로 말하지 마!",
 "65a41a86a14c": "너론 안 돼~.",
 "078680e1a9d6": "오늘은 좀 봐줘!",
 "0daf865128c3": "흐음, 그래?\n어쩔 수 없네.",
 "cabe006ba978": "이제 와서 그런 말\n하지 마.",
 "6cea2eaa2cea": "......\n쳇.",
 "c49ab4f05299": "간다!!",
 "ca128372537e": "도망치자.",
 "f67e3960328a": "네 말대로네.\n그럼 잘 부탁해.",
 "998697d71b2d": "정말, 머리 굳었다니까.\n나 돌아갈래, 그럼.",
 "a8e9bf311ea1": "너도 머리 나쁘구나.\n혼자 오다니. 킥.",
 "ee4ed523c980": "드디어 내 차례다!",
 "c18fc8b0d480": "해 주마!",
 "50556c502c06": "어디서든\n덤벼라!",
 "73ffd731e374": "내 필살기를\n버틸 수 있을까?",
 "f6fea44c37c3": "어설픈 싸움은\n안 한다!",
 "d3588495a657": "눈 깜짝할 새에\n처치해 주마!",
 "2497befe1cb2": "적 사단장과\n교섭하시는 겁니까?",
 "7c0eb78f2fe6": "어느 무장을\n출진시키시겠습니까?",
 "b39152c8724b": "⟦V 06⟧ 님께서\n적의 포로가 되었습니다!",
 "53a475da7c88": "⟦V 06⟧ 님께서\n전사하셨습니다......",
 "96b077fc781d": "적 무장 ⟦V 06⟧,\n사로잡았습니다!!",
 "aefa1e8d33b5": "⟦V 06⟧ 님께서\n전사하신 듯합니다.",
 "55efeb5f2397": "정말\n퇴각하시겠습니까?",
 "113094bf2f04": "누구를 출진시키겠습니까?",
 "73d22a783a1a": "적 사단에 붙잡혔던 자가\n풀려난 듯합니다!",
 "9adfa5994cf2": "형세가 불리합니다.\n일시 철수하겠습니다!",
 "bd2aa2c08cfa": "⟦V 06⟧ 님께서\n부상을 입은 듯합니다!",
 "0dfe132ae182": "⟦V 02⟧ 님,\n아군이 패배했습니다.",
 "f7f1336d7549": "⟦V 02⟧ 님,\n아군의 승리입니다!",
 "8502f9333582": "⟦V 05⟧ 사단이\n퇴각하는 듯합니다!",
 "a1f26c6de8ee": "⟦V 02⟧ 님,\n아군이 전멸했습니다...",
 "35dba6f7f531": "⟦V 09⟧ 님께서\n아군에 가담했습니다!",
 "83546ccceae6": "이럴 수가! ⟦V 09⟧,\n배신했습니다!",
 "a0491c4112ee": "웨인 님,\n적군이 전멸했습니다!",
 "47e27546dcee": "적 사단이 끌고 가던\n포로 무장을 붙잡았습니다!",
 "229d4324c1d0": "포로로 잡았던 무장을\n적에게 빼앗겼습니다!",
 "9c014adb555e": "퇴각에 실패한 병사가\n나온 듯합니다!",
 "65d6c1ca6e90": "끌고 가던 포로를\n적에게 빼앗겼습니다!",
 "7bc3f0e35900": "웨인 님, 여기선\n퇴각하시는 편이...",
 "dda10a5f8911": "웨인 님, 적 성의 공략에\n실패했습니다...",
 "07a159c99a1c": "웨인 님, 적 사단이\n물러나고 있습니다!",
 "99b9b5acbdd3": "웨인 님, 아군의 성이\n함락되었습니다...",
 "23da06da87e0": "크크크, 그 또한\n일흥이로다.",
 "a5522b6a77b1": "드디어 만났군,\n골다크. 이 불충한 놈.",
 "1dc801e7aad3": "호오. 기젤다크의\n자식, 타이렐인가.\n\n변경 원정에 나가 있다고\n들었거늘,\n\n뻔뻔하게도 돌아\n왔구나.",
 "749615789920": "잘도 내가 없는 사이에\n아버님을 죽이고\n\n나라를 빼앗았구나.\n그 소행, 결코 용서 못 한다.",
 "34f072c3b0cb": "너 같은 애송이가\n아비의 원수를 갚겠다고?\n\n가소롭다. 네 실력으론\n짐을 칠 수 없다.\n\n지금 항복해라.\n목숨만은 보장해 주마.",
 "75c5d3a57fa0": "닥쳐라! 골다크.\n네놈을 쓰러뜨리고\n\n그 목을 아버님 무덤에\n바치겠다.",
 "c3decb65325b": "아버님의 원통함, 지금 여기서\n풀어 보이겠다.",
 "335c873ae94d": "나약했던 네가 얼마나\n성장했는지 봐 주마.",
 "d807726d0f72": "골다크. 네놈의 야망도\n여기까지다.",
 "3bcfbed76f00": "나의 패도는 누구도\n방해하지 못한다.",
 "bfb3e1851274": "골다크에게 가담하는\n자들이여.\n\n나는 놈과는 다르다.\n항복하면 살려 주겠다.\n\n하지만 끝까지\n맞선다면\n\n죽음뿐이다!",
 "c144192cbfd1": "젠장, 원통하다.\n나의 무운도 다했는가.",
 "3c3b2dcbfe60": "타이렐을 신하들과 함께\n사로잡았습니다.",
 "8d75ff68d41b": "판다리아 제국의\n골다크로군요.\n\n당신은 왜 전쟁을\n시작한 건가요?",
 "1f5d981a8031": "너 같은 계집아이에게\n말할 필요 없다.",
 "27df8561b209": "당신의 눈동자는 슬픔으로\n가득해요.\n\n뭔가 이유가 있겠지요.\n전쟁을 일으킨 이유가.",
 "806177c212dd": "흥.\n겉모습은 어리다지만\n\n과연 문팰리스의 여왕\n답다고 할까.\n\n좋다.\n조금만 이야기해 주지.\n\n짐에게는 쓰러뜨려야 할\n강대한 적이 있다.\n\n그를 위해 뛰어난 전사가\n많이 필요한 것이다."
}
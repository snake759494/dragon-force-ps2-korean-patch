{
 "1b9127570c31": "⟦V 09⟧ 님을\n찾아냈어요!",
 "0d6ce180f9c1": "저기, 그게...\n죄송해요.",
 "a63f88394458": "그런가요...\n어쩔 수 없네요.",
 "d142a0ea1876": "!?\n\n⟦V 0F⟧, 찾았어요!",
 "0eb3f1b45dff": "유이카라고 해요.\n잘 부탁드려요!",
 "3f9bd5e2dd9d": "생각보다 잘 됐네.",
 "cda068a29055": "이래선 안 되겠어.",
 "c00d480950db": "여러분! 부디 저희 군대에\n들어와 주세요!\n\n예비병 보충에\n성공했습니다.",
 "224a42788b3b": "어떻게 하면 좋을까.",
 "a0cf8d7470ad": "포기하죠.",
 "ebf33bfbdac7": "너무 시시한 상대랑은\n싸우게 하지 말아 줘.",
 "b2926f07edf6": "이래서야 내 공격 마법을\n보여 줄 필요도 없겠네.",
 "ada69c8edb19": "나한테 맡겨 두라니까!",
 "6abbffe415d4": "나한테 다 맡겨 두면\n문제없어.\n\n공격도 수비도 OK인\n만능 승려 샤이아 님한테!",
 "26cc81667ad7": "이 성에는\n아이템이 있는 것 같아.",
 "e1253eb0acd5": "음, 가끔은 싸우는 것도\n괜찮으려나.",
 "b59681112a20": "고마워.\n잘 쓸게.",
 "6cdfc50c7a5c": "이런, 이런...\n멋없는 짓을 하네.",
 "e6220da646a2": "이런 것보다 연구실이\n갖고 싶은데, 난.",
 "3aef0214c932": "글쎄, 너하고는 더는\n못 어울릴지도 모르겠네.",
 "6067fc0bb90a": "정말이지, 너한테는\n정나미가 떨어졌어.",
 "a981bfda8df4": "그래도 나, 꽤 의리 있는\n편이거든.",
 "bd6f01317d8d": "넌 나를 부릴 만한 그릇이\n아니야.",
 "93f95087aad2": "사양할게. 너하고는\n취향이 안 맞아.",
 "3ad946ed6947": "네 얼굴 안 봐도 되는\n여기가 더 편해.",
 "5606ddff5d5a": "협력해 줄게. 그런데\n날 잘 다룰 수 있으려나?",
 "1d3c4bd4a102": "좋아, 너라면\n내 눈에 찰 것 같으니까.",
 "beb92c4b97bb": "찾았다.\n\n정말 손 많이 가게 하네.\n우리 동료가 되어 줘!",
 "6786313299b5": "앗! 여기 있었네.",
 "1f146bd21907": "⟦V 00⟧, 그게 나야.\n무슨 용건이지?",
 "85afbf005fda": "우리 나라에서 일해\n보지 않을래?",
 "3cf778d664c2": "그래, 좋아.\n한번 발 벗고 나서 볼까.",
 "984adfb85908": "찾아왔어.",
 "1f5612fa30cd": "지금 바쁘거든.\n다음에 또 와 줄래?",
 "1ba26101c88d": "아, 그러셔.\n맘대로 하라고!!",
 "d3c19fe724c7": "??\n\n⟦V 0F⟧, 손에 넣었어.",
 "b1b041fb8bad": "제 이름은 ⟦V 00⟧.\n잘 기억해 두시길.",
 "3ea4985511ee": "따분하네.",
 "273fd1781e39": "대충 이 정도지.",
 "6d1ea2d87587": "성 레벨이 1 올랐어.\n참 나, 왜 내가...",
 "23a2862ab7de": "성 레벨이 2 올랐어.\n이제 지긋지긋해.",
 "153345f25fb2": "뭔가 위험해 보이는데.",
 "1d2c6c8ea0fd": "거기 귀여운 총각들, 누나가\n좋은 데 데려가 줄게.\n\n예비병 보충에\n성공했어!",
 "81c16f078849": "이거 참, 곤란하네.",
 "4c7bbcdcbacd": "완전히 두 손 들었어.",
 "096c964ea355": "...분전하고 있다.",
 "7f650a1aa791": "...전황은 유리하다.",
 "fd182e4b03cf": "...문제없다.",
 "048bd88ccc11": "...후회는 시키지 않겠다.",
 "70bf43f31a22": "......\n아이템이...",
 "c6dc1747bb30": "싸움만이 전부다.",
 "43cddf6665c4": "받아 두지.",
 "abede56f5aed": "...딱히 아무것도.",
 "2b45c67ecac0": "...감사합니다.",
 "ffb669bafd8f": "역시 여기를\n떠나야 하는 건가...",
 "997e7052ba1e": "⟦V 02⟧ 공.\n당신에게는 실망했다.",
 "26634ff1c839": "...잘 있어라.",
 "d4f8dc4f40f3": "...신세 지겠다.",
 "eecb91a2b9e7": "??\n\n없습니다.",
 "593b3acda19a": "!!\n\n당신이 ⟦V 09⟧인가.\n힘을 빌려줘.",
 "21de8771c8f0": "!!\n\n당신이 ⟦V 09⟧인가.\n좋은 눈을 가졌군.",
 "924d579f6901": "...그렇다.",
 "39bc031ddc79": "힘을 빌려줘.",
 "0180e266626e": "...알았다.",
 "61feb2e23733": "...데려왔다.",
 "8539a4a6f2aa": "...거절한다.",
 "99147942ad00": "...어쩔 수 없군.",
 "c9ab44c48528": "??\n\n⟦V 0F⟧, 찾아냈습니다.",
 "38b806516881": "...라이작이다.\n......잘 부탁한다.",
 "4bf23345ff81": "...이 정도인가.",
 "be5628008d22": "...만족스럽다.",
 "3e9dca084c35": "공사 완료.\n성 레벨이 1 올랐다.",
 "559aafa1b2c8": "공사 완료.\n성 레벨이 2 올랐다.",
 "e3264cdcc14f": "이번에는 무리군.",
 "61fc1794027e": "...너희들,\n이리 와라.\n\n예비병 보충에\n성공했습니다!",
 "6992778eecec": "...문제 있군.",
 "7b7b594af83f": "...도망칠까.",
 "95a296e7364e": "충실한 나날입니다.",
 "6ee770685ac2": "아주 순조롭습니다.",
 "965f7cf6ae54": "다소 열세입니다만\n곧 만회하겠습니다.",
 "887880db75f7": "하루빨리 평화로운 세상으로\n돌아가면 좋겠구려.",
 "a9507c5368a9": "이 성에는 아이템이\n있다고 합니다.",
 "4409df1783fa": "이제 내 차례는\n두 번 다시 오지 않는 건가.",
 "5292b65733ba": "불만 같은 건 없습니다.",
 "cb0266ebf7ec": "이 이상의 포상은\n없겠구려.",
 "c22d43ef21a6": "아무래도 내가 업신여김을\n받고 있는 듯하구려.",
 "bc0a55da2a1d": "...이제 여기까지인가.",
 "f22a69016918": "내가 있을 곳은\n아닌 모양이군.",
 "6c12d1fa6370": "아무래도 당신을\n너무 높이 샀던 모양이오.\n\n스스로 해 온 일을\n떠올려 보시오.\n\n그럼 이만.",
 "2ed01aa0336b": "내가 분노를 누르고 있을 때\n사라지시오.",
 "ee627c2e54ed": "미력하나마 돕도록\n하겠습니다.",
 "3fee414dbf28": "??\n\n죄송합니다.\n실패했습니다.",
 "6c792eb02581": "!!\n\n당신이\n⟦V 09⟧ 공이시오?\n\n우리에게 힘을\n보태 주지 않겠소?",
 "146a1afc6f66": "!!\n\n당신이\n⟦V 09⟧ 공이시구려.",
 "5d1075eca72e": "음. 그렇소만,\n무슨 용건이오?",
 "19066b6f5e86": "귀공, ⟦V 02⟧ 님을\n만나 볼 생각은 없소?",
 "177961397281": "알겠습니다.\n가시지요.",
 "766ac563d87a": "⟦V 09⟧ 공을\n모셔 왔습니다.",
 "ea77f742531a": "미안하지만 오늘은\n돌아가 주시오.",
 "109fcfb89734": "어쩔 수 없겠군.",
 "4fbb76898451": "??\n\n⟦V 0F⟧, 찾았습니다!",
 "1e501d56cb99": "내 이름은 라기.\n앞으로 잘 기억해 두시오.",
 "c4edc7d4df96": "음. 예정대로다.",
 "1bab19367ba8": "예상 이상의 완성도군.",
 "fd9507ca6f18": "끝났습니다. 성 레벨이\n1 올랐습니다!",
 "ca24003b7a95": "완료했습니다. 성 레벨이\n2 올랐습니다!",
 "12205d72d9e1": "또 해 버렸군.",
 "c3e8e327897d": "거기 젊은이들.\n우리 군에서 힘을 시험해 봐라.\n\n예비병 보충에\n성공했습니다!",
 "7b452b485b6f": "이거, 안 되겠군.",
 "f891cc633e5c": "너무 잘 풀려서 무서울\n정도예요!",
 "3185b5b653f0": "지금부터 팍팍\n나갑니다!",
 "6598fc0a2b24": "이 정도면 보통이에요.",
 "7a0ab11c58f4": "더 싸우고 싶다고.",
 "85cecb1dcd2a": "이 성에선 아이템\n냄새가 나는데.",
 "a3709f3bd4b6": "정원 청소 같은 건\n제 취미가 아니라고요.",
 "4f9ec304d8dc": "고맙수!",
 "554e629f98ed": "...쳇,\n변덕스럽기는.",
 "63cf438a736a": "좋았어!\n이걸로 의욕 두 배!",
 "10dd0a6068a1": "역시 당신하고는\n죽이 안 맞아.",
 "9a4754761e44": "정말이지, 당신한테는\n정나미가 떨어졌다고.",
 "10126c570171": "잘 있으라고.",
 "816b61621011": "그럼 간다. 두 번 다시\n만날 일은 없겠지.",
 "f36a1833a3d6": "웃기지 마!",
 "5a519c214abe": "뭐, 괜찮겠지.",
 "7f322d8c9031": "신세 좀 지겠수.",
 "001d2cf04961": "??\n\n실패다...\n아깝네...",
 "30c91bcf0d7a": "!!\n\n당신이 ⟦V 09⟧인가.\n우리 군에 들어와 줘.",
 "1ec94597092e": "그래, ⟦V 00⟧, 바로 나다.\n무슨 일이야?",
 "3e45a562cbab": "당신, ⟦V 02⟧ 님을\n만나 볼 생각 없어?",
 "7573f09b575f": "그렇게까지 말한다면\n어쩔 수 없지. 알았어.",
 "425b6546d0a0": "⟦V 09⟧ 녀석을\n데려왔수다.",
 "fc9f3666ed29": "미안하지만 그럴 생각 없어.\n돌아가 줘.",
 "ee60527e3d39": "어쩔 수 없구먼.",
 "f2fd165d3529": "내 이름은 ⟦V 00⟧!\n잘 부탁해!",
 "2c5d3f7891e8": "꽤 재미있는데.",
 "36daa2e5fe3c": "나, 재능 있는걸.",
 "cd30f82013c2": "끝났수다.\n성 레벨이 1 올랐어!",
 "f7b7c263c6bd": "완료했수다.\n성 레벨이 2 올랐다고!",
 "db0c892a6bf6": "너희들! 병사가 안 되면\n가만 안 둔다!!\n\n예비병 보충에\n성공했습니다!",
 "30fb9ddf1b23": "재능 없네, 나.",
 "16421fdf5abf": "이제 완벽해요.\n좋은 싸움을 하고 있답니다.",
 "fc9a37561e8c": "순조롭게 되어 가고 있는\n것 같아요.",
 "eb58bdbfcc33": "상황으로 보면 지금은\n좋지 않네요.",
 "b3a23ab745ba": "저는 수인족 중에서\n유일하게\n\n\"정령사\"라는\n특수한 능력을 갖고 있어요.\n\n그러니 전투 지원은\n맡겨 주세요.",
 "dcde4727fe8f": "아이템이 있는 것 같은데\n말이죠...",
 "2cf6a98345de": "왠지 따분해.\n⟦V 02⟧ 님, 왜죠?",
 "2fc791a12665": "야호! 실은 전부터\n갖고 싶었거든요, 이거.",
 "c5ecd5ef0d99": "...에휴, 의외로\n쩨쩨하시네요.",
 "adcd6700a5d1": "왠지 미움받고 있는 것\n같은 기분이 드네.",
 "6f6658e24b36": "음, 아무래도 여기 있기가\n불편해진 것 같은데...",
 "977a61408c26": "무슨 일이 있어도\n따를 수는 없어.",
 "3c15d60cdd52": "그런 건\n절대로 못 해.",
 "a26b0ccc9954": "이제 그만\n포기해 줘.",
 "54ea1ae59a8a": "모시고\n따르겠습니다.",
 "6978c0b4bc95": "네, 저라도\n괜찮다면 기꺼이.",
 "fc3b3f632011": "!?\n\n미안해요.\n탐색에 실패해 버렸어요.",
 "9720e370ac2c": "!!\n\n⟦V 09⟧ 님이시죠?\n힘을 빌리러 왔어요.",
 "90a1d2f49a56": "!!\n\n⟦V 09⟧ 님이시죠?\n찾았어요.",
 "f8776f99f2c8": "내가 마니인데,\n무슨 일이야?",
 "7486f60d4e2c": "찾고 있었어요.\n부디 협력해 주세요.",
 "059c5e82e1e3": "미안해요.\n조금 생각하게 해 줘요.",
 "a92d4396060d": "...그런가요.\n그거 아쉽네요.",
 "6b56825f8738": "??\n\n⟦V 0F⟧, 발견했어요.",
 "ef36d2c2d566": "안녕, 마니예요~.\n잘 부탁해요.",
 "62e5c635164e": "이런 느낌일까.",
 "c3f54186f04b": "좋아, 내가 봐도 잘 됐어!",
 "63a7df7ed981": "⟦V 02⟧ 님, 성 레벨이\n1 올랐어요.",
 "982649e1428a": "⟦V 02⟧ 님,\n성 레벨이 2 올랐어요.",
 "9edf8d80a48d": "공사는 실패한 것 같네요.",
 "0419df66706c": "있잖아, 군대에 들어와서\n한번 날뛰어 보지 않을래?\n\n예비병 보충에\n성공했어요!",
 "aaa9141a6e00": "왜 이렇게 되는 걸까.",
 "7807e30ae378": "축성은 어렵네.",
 "88246492511f": "나의 기운은\n끝이 없는 거다아!!",
 "0f5b023b731f": "컨디션이 좋아서\n밥맛도 꿀맛인 거다아.",
 "452ef072b4c5": "평범하게 지내는 것도\n가끔은 좋은 거다아.",
 "e3ff5bc90915": "⟦V 02⟧ 님을 위해\n유니는 더, 더\n\n도움이 되고 싶은 거다아!",
 "ceedabc772cf": "이 성에서는 아이템\n냄새가 나는 거다아!",
 "3603bdf59f12": "더 ⟦V 02⟧ 님에게\n도움이 되고 싶다아!",
 "f3aee560237f": "소중히 쓰는 거다아.",
 "8d6cf61bf39b": "...우우우.\n그건 너무한 거다아.",
 "a9b7d59c4a48": "야호!\n고마워, 고마운 거다아.",
 "4c8cbc695e51": "요즘엔\n활약을 못 하는 거다아.",
 "c2ac2f64abf0": "심심한 거다아.",
 "6d47575a143c": "숲으로 돌아가는 거다아.",
 "931f659ed5a8": "⟦V 02⟧ 님한테는\n유니 따위 필요 없는 거다아.",
 "536580852078": "곤고스 님한테 물어봐야\n알 수 있는 거다아?",
 "3a5efdc17e1b": "잘 부탁하는 거다아.",
 "0e78012fa87d": "!?\n\n미안해요.\n실패한 거다아.",
 "e672f3a4457d": "!!\n\n⟦V 09⟧ 님인 거냐?\n냐아?",
 "075d07969531": "!!\n\n⟦V 09⟧ 님인 거냐?\n찾고 있었던 거다아.",
 "28311179958a": "그런 거다아!\n내가 유니인 거다아.",
 "e52de0191c92": "찾고 있었다아.\n협력해 줬으면 하는 거다아.",
 "86bd0ece8a8d": "응, 알았다아.\n협력하는 거다아.",
 "e4dc16d519c5": "탐색은 성공인 거다아.\n해낸 거다아.",
 "dfa3a2f5f844": "미안한 거다아.\n거절하는 거다아.",
 "5686328dd13f": "정말 아쉬운 거다아.",
 "00eff8585ae7": "??\n\n⟦V 0F⟧, 발견한 거다아!",
 "575efc4f1d9b": "안녕인 거다아.\n유니라고 하는 거다아.",
 "2e66bcf1284c": "공사가 끝난 거다!",
 "32db3727fa3f": "잘 만든 거다아!",
 "094cb7d09596": "⟦V 02⟧ 님,\n\n성 레벨이\n1 오른 거다아!",
 "e802cba238c8": "⟦V 02⟧ 님,\n\n성 레벨이\n2 오른 거다아!",
 "a45da2eb3032": "실패한 거다아!",
 "9fe82f0b41c2": "냐아!\n\n병사님 보충에\n성공한 거다아!",
 "82976a21fda3": "후냐?",
 "0ecb89bc3525": "우우, 혼나는 거다아.",
 "3141a77769c3": "우아한 싸움을\n펼치고 있습니다.\n\n안심하십시오,\n⟦V 02⟧ 폐하.",
 "0b8bb543d802": "그럭저럭 성과를 올리고\n있습니다.\n\n이 아이로스에게 모든 것을\n맡겨 주십시오.",
 "c38703938bcd": "안심하십시오. 순조롭게\n진행되고 있습니다.",
 "ddd6597d14ea": "제게 출진 명령을 내려 주시길\n진심으로 기다리고 있습니다.",
 "1d448ea46eff": "이 근처에\n아이템이 있다고 하더군.",
 "62eface5025f": "가끔은\n이 평화로운 나날에\n\n빠져 버릴 것만\n같습니다.",
 "05e7fab234bc": "앞으로도 이 아이로스에게\n맡겨 주십시오.",
 "33948acda43e": "이, 이럴 수가!\n어떻게 된 거지?",
 "96249a627731": "훈장이야말로 내게 어울리지.\n감사히 받겠습니다.",
 "910b05773e02": "어째서입니까? 이런 대우,\n납득할 수 없습니다!\n\n제게는 기사로서의\n자격이 없다고 보십니까?",
 "9285fe001bb5": "적당히 해라. 나에게도\n기사로서의 긍지가 있다.",
 "a8c1895f049b": "이제 아무 말도 않겠습니다.\n...부디 건강하시길.",
 "cfdcd6856804": "당신을 더는 따를 수\n없소. 실례하겠소.",
 "670b462f363d": "거절하겠소. 내가 섬기는 왕은\n주논 님 단 한 분뿐!",
 "cc8f9264e321": "그분이 그렇게 생각하신다면\n나는 어디까지라도 따르겠소.",
 "21994a7ebd2c": "...\n\n수확 없음인가.\n젠장.",
 "2b76be880b2e": "??\n\n⟦V 09⟧ 공.\n찾았습니다.",
 "39938df01929": "!?\n\n⟦V 09⟧ 공.\n찾았습니다.",
 "f47f0722645c": "내가 아이로스요만,\n무슨 용건이오?",
 "a5a5b4a99feb": "부디 우리나라에\n협력해 주셨으면 하오만.",
 "4d7a86ab614e": "주논 님께서 지금\n귀공의 군에 종군하고 계신 이상\n\n나도 그분의 뜻에\n따르기로 하겠소.\n\n잘 부탁하오.",
 "380c41ebda85": "⟦V 09⟧ 공의\n권유에 성공했습니다!",
 "b38868d2abc6": "내가 섬기는 군주는 이 세상에\n오직 한 분뿐이다!",
 "4c0a32422b6e": "아쉽군.",
 "ca082e3df1fe": "!!\n\n⟦V 0F⟧, 발견했다!",
 "25ecb6ca8df3": "반갑소. 내 이름은 ⟦V 00⟧.\n\n...잘 부탁드리지요.",
 "3d97e130b0e8": "나쁘지 않은 솜씨군.",
 "063f50a533b5": "음. 최고의 완성도다.",
 "1b38cae32adc": "보고드립니다.\n성 레벨이 1 올랐습니다.",
 "7f819aeb3f5c": "보고드립니다.\n성 레벨이 2 올랐습니다.",
 "b09a091491f8": "실패했나.",
 "41caa79f0352": "자네들, 긴장감 넘치는\n생활을 해 보고 싶지 않나?\n\n병사 보충에 성공했습니다.",
 "cb8431391624": "아름답지 않군...",
 "803ebbcd45fa": "최악이다...",
 "a5a162227da1": "제 마법도\n점점 갈고닦여 가고 있습니다.",
 "077dcb46bc55": "다음 싸움에도\n참전을 희망합니다.",
 "d9a01ada564e": "언제든지\n불러 주십시오.",
 "a55d65fb8586": "이 성에는 아이템이\n있을 것 같은 느낌이...",
 "9bb0a8ea0256": "...아뇨,\n아무것도 아닙니다.",
 "d5c3c545d655": "깊이 감사드립니다.",
 "e81ae422c619": "...후우, 그런 일을\n하시는군요.",
 "e97ae8193012": "언젠가 이렇게 될 거라고\n생각은 했습니다만...",
 "cad20eac1968": "신세 많이 졌습니다.\n부디 건강하시길.",
 "43903a03bf59": "농담도 참.",
 "ed4d62b3f4cd": "저에게도 여러모로\n생각하는 바가 있어서요.",
 "3381913ec8c6": "......당신과는\n아무것도 나눌 이야기가 없다.",
 "70ef39876f94": "그분의 뜻대로\n따르겠습니다.",
 "30fbf7712bbd": "...\n\n⟦V 02⟧ 님,\n탐색에 실패했습니다.",
 "7c70f850073a": "!!\n\n⟦V 09⟧ 님이십니까?\n\n당신을 찾고 있었습니다.\n부디 우리나라에 협력을.",
 "64d4962f098e": "!!\n\n당신이 그 명성 높은\n⟦V 09⟧ 님이시군요.",
 "642c8d08d921": "네.\n마도사 ⟦V 00⟧, 바로 접니다.",
 "67223c6bc180": "부디 우리나라의 무장으로\n싸워 주셨으면 합니다.",
 "c65e8aedae20": "미안하지만 그건\n들어줄 수 없습니다.",
 "b151be84eec1": "⟦V 02⟧ 님,\n기뻐해 주십시오.\n\n⟦V 09⟧ 님을\n우리나라에 편입했습니다!",
 "c2b10bc4862a": "돌아가 주십시오.",
 "1dd565337ef7": "...그렇습니까.\n아쉽군요.",
 "85a123c1e777": "이건! 훌륭합니다.",
 "f4f6eefd97cd": "⟦V 02⟧ 님,\n성 공사가 완료되었습니다.\n\n우리 진영의 성 레벨이\n1 올랐습니다.",
 "ff9ea7d982e1": "⟦V 02⟧ 님,\n성 개축이 끝났습니다.\n\n그 결과 성 레벨이\n2나 올랐습니다.",
 "5e72d8b45da2": "잘 안 되는군요...",
 "f2df3ffda9cd": "오야?\n\n⟦V 02⟧ 님,\n지원병이 모여들었습니다!",
 "1fd1d4106c96": "...잘 안 되는군.\n\n더 이상 축성을 계속해도\n소용없을 것 같네요.",
 "bd1badae054b": "헛수고로 끝났나.",
 "b78f0d92d224": "...문제 따윈\n티끌만큼도 없다.",
 "e44b6c5c8aa6": "순조롭게... 진군 중이다.",
 "ddc106c8abb2": "...전투는 안 하고 있다.",
 "3f1a99cfdf02": "...여어.\n\n잘 부탁...한다.",
 "a2f7ba505269": "...뭔가 아이템이\n있는...것 같다.",
 "e939097df7da": "...한가하군.",
 "fbf0c28ce29f": "이걸로... 전력을\n보강할 수 있겠군. 고맙다.",
 "93c6bc99b88a": "어째서지......",
 "c64b554f963a": "...고맙다.",
 "022777cf88f1": "...너무\n우쭐대지 마라.",
 "0fe5f4380198": "...이건 너무하잖아.",
 "f2214b506808": "...신세 졌다.",
 "f8bc53e1acdc": "난 필요 없는 모양이군.\n...잘 있어라.",
 "31ad788ad7ca": "...그 녀석을 배신할 수는\n없다.",
 "023813478db0": "...나한테 묻지 마.\n다른 데 알아봐.",
 "9350775caa62": "...미안하지만 그건\n들어줄 수 없다.",
 "4d20b26adf04": "...알았다.\n함께 싸우지.",
 "d078d9813c3c": "...좋다.\n이 목숨, 맡기지.",
 "8bd6c6596c5a": "??\n\n없었다...\n포기하는 게 좋겠어.",
 "31c7cda3ede1": "!!\n\n당신이 ⟦V 09⟧인가.\n힘을 빌려줬으면 한다.",
 "2fe909731533": "!!\n\n당신이 ⟦V 09⟧인가.\n찾고 있었다...",
 "5d74e8ce3495": "우리와...\n이쪽으로... 와라.",
 "d1f653ec287c": "지시대로 확실히\n데려왔다.",
 "3a412039e0ff": "..미안하지만 돌아가 줘.",
 "67688ec9eb2c": "...그런가.\n어쩔... 수 없지.",
 "a547380454ca": "??\n\n⟦V 0F⟧... 찾았다.",
 "83f93ed84cff": "......\n그럼... 잘 부탁한다.",
 "e2582e80241b": "후우...",
 "71b2c6185e9c": "모두 잘 해 줬다.",
 "f23b9d340323": "끝났...다.\n레벨이 올랐다, 1.",
 "384feaa4363b": "...완료다.\n왠지 2 올랐다!",
 "5c09b6056a15": "이번엔 틀렸...군.",
 "dbafd8ec5abe": "이놈들아!\n나와... 함께 가자!\n\n병사 보충에\n성공했다...",
 "132c6af33720": "...실수했나.",
 "d515788aa0ee": "...돌아가서 자겠다.",
 "7c97b6a38846": "쾌조다. 문제없어.",
 "eb045d65ec1a": "순조롭다고.\n전선은 맡겨 둬.",
 "cd3c8f6f6c6c": "전황은 그렇게 나쁘지 않아.\n슬슬 기세를 올려 볼까.",
 "deceee8d14a6": "에휴, 한가하네.\n내 성미에 안 맞아.",
 "ff59be0b8f1a": "아무래도 여기에 엄청난\n아이템이 잠들어 있는 모양이야.",
 "10ab4e5e9c77": "나를 전선에 보내 줘.\n검이 녹슬겠다고.",
 "23b3e63486eb": "꼭 쓸모 있게 쓰지.\n고맙다고.",
 "8d0d96265848": "의외로 속이 좁구먼.",
 "3fe3cd81c4ce": "고맙게\n받아 두지.",
 "837af08a510c": "당신한테는\n더 못 어울려 주겠어.",
 "f1ec57101e7a": "적당히\n좀 해 줬으면 좋겠군.",
 "638df4e166e7": "잘 있어라!",
 "50c4580545ad": "그럼 간다!",
 "5d3e82922f01": "사양하지.",
 "aec781647f17": "내 체질이 아니야. 미안.",
 "af564a13a651": "몇 번을 와도 대답은 같아.\n못 따르겠어, 미안하군.",
 "25e2222bf467": "그래, 좋아.\n잘 부탁한다고, 대장!",
 "66b79e92aabf": "실패한 모양이군.",
 "60529893a766": "!?\n\n⟦V 09⟧ 씨지?\n찾고 있었어.",
 "8b4b1bfca0cb": "!!\n\n혹시\n⟦V 09⟧ 씨야?",
 "7d5ff24c4f5a": "그래, 그런데.\n나한테 무슨 볼일이야?",
 "c6276ba0ac9e": "우리와 함께\n싸워 주지 않겠어?",
 "b152e42b64da": "그래, 알았어.",
 "6c1ebdb1f90d": "⟦V 02⟧ 님,\n탐색에 성공했다고!\n\n⟦V 09⟧ 녀석을\n데려왔어!",
 "c372bbbc2c9a": "공교롭게도 지금은 다른 일이\n밀려 있어서 말이야.\n\n지금은 안 되겠어.\n미안. 다음에 또 와 줘.",
 "75202de243d6": "그래?\n실례했다.",
 "0625d79d0e0a": "!!\n\n⟦V 0F⟧, 발견했다고!",
 "64cd5f4a0906": "조슈아다.\n뭐, 적당히 잘 부탁해.",
 "2a204e0a1bd7": "뭐, 이 정도인가.",
 "1ce496fea4a3": "괜찮은데 그래.",
 "b96926011050": "대장!\n대충 끝났어.\n\n성 레벨이\n1 올랐다고!",
 "2ff0062d55f1": "⟦V 02⟧ 님,\n공사 완료다.\n\n성 레벨이 무려\n2나 올랐다고!!",
 "4de04bfe1c52": "실수했군...",
 "e1c4a33ba7ae": "대장!\n쓸 만한 병사가 있었어.\n\n병사 보충을 해 뒀다고!",
 "46174df2a1a9": "...이런, 이런.\n\n나한테는 좀\n무리였나...",
 "513f7b6f2c7b": "곤란하게 됐군.\n\n변명할 여지도 없어.",
 "b21a6cd8be3d": "걱정할 것 없다.",
 "38e22e5c26ba": "음, 문제없소이다.",
 "c8a3c6b29d9f": "아아......\n다시 원래 생활로 돌아왔군.",
 "f9d63a9a6d6f": "다시 전쟁의 불길 속으로\n돌아오게 될 줄은\n\n생각지도 못했다.",
 "44bff5e04517": "아이템이 있는 모양이군.",
 "c65dbedaaee1": "문제없다. 평온무사하다.",
 "b0ffefde5039": "고맙소.\n잘 쓰겠소.",
 "a9c61428d8b4": "원래 필요 없던 것이다.\n그저 그뿐이다.",
 "bd2d819ac6bc": "기대에 부응하도록\n힘쓰겠다.",
 "a9ee608aaf58": "이 허무함은\n사라질 것 같지 않군.",
 "8191047535de": "역시 남을 섬긴 것이\n잘못이었나.",
 "39dd0418f683": "소인을 얽맬 수 있는 자는\n아무도 없다.",
 "1d9ed642be23": "더 할 말은 없다.\n잘 있거라.",
 "48eb9e7ce3ed": "관심 없다.\n다른 데 알아보시오.",
 "082edd8c1c42": "소인에게 상관 마시오.",
 "136110de24b3": "상관하지 말아 주시오.",
 "3a58c5d0b79e": "알겠소. 그대 밑에서\n싸우는 것도 좋겠지.",
 "7c0438f331f4": "소인이라도 괜찮다면\n돕도록 하겠소.",
 "f19c55f4d38b": "당신은!!\n\n아무래도 사람을\n잘못 본 모양이오.",
 "80c45459500c": "⟦V 09⟧ 공이시군.\n\n부디 우리 군에\n참가해 주셨으면 하오.",
 "3da3a9f7610c": "!!\n\n한참 찾았소.\n⟦V 09⟧ 공이시오?",
 "82aaa91d8a80": "그렇소, 소인이 바로\n⟦V 00⟧ 올시다.",
 "975e72e3aac0": "부디 우리 군에\n합류해 주셨으면 하오.",
 "277689dca03b": "알겠소.",
 "68932bd327c4": "⟦V 09⟧ 공을\n찾아냈소이다.",
 "8b669ab230b3": "미안하지만\n돌아가 주시오.",
 "076fd46abea8": "으음, 이건...\n\n⟦V 0F⟧, 손에\n넣었소이다!!",
 "0cd384228043": "⟦V 00⟧ 올시다.\n잘 부탁하오.",
 "ece65e0f519f": "순조롭게 끝났군.",
 "ecd4ded42207": "나무랄 데 없는 완성도다.",
 "4d99960022ce": "성 레벨이 1\n올랐소이다.",
 "727093d50266": "성 레벨이 2\n올랐소이다.",
 "67e39cc5ded0": "뜻대로 되지 않는군.",
 "a49360205620": "너희들, 단련하면\n쓸 만하겠군.\n\n병사 보충에 성공했습니다.",
 "c71b813ba684": "원통하다...",
 "28229f08c8d5": "내가 미숙한 탓인가. 원통하다.",
 "f1d6d976ea70": "식은 죽 먹기,\n가는 곳마다 적이 없다고.",
 "eb025f760ba6": "쾌조, 쾌조,\n고마워하라고!",
 "ce25845094e0": "좀 불리하긴 해도\n그럭저럭이랄까.",
 "4a445c558b3a": "하야테 님과 함께라면\n불구덩이든 물구덩이든\n\n휘리릭 적을\n해치워 버린다고요.",
 "bca0a1d74305": "아이템이 있는 것\n같아요.",
 "20a818ad1d0b": "한가하네요. 뭐,\n나는 어차피\n\n늘 수련하니까\n상관없지만요.",
 "c9673e2f0277": "오, 멋진데.\n받아 갈게요!",
 "a3d98415dd0b": "...쳇.\n짠돌이 같으니.",
 "f29b08814707": "야호!\n고맙습니다.",
 "e1bc8343043e": "줄 걸 안 주면\n불평도 나오는 법이지...",
 "6b37fc5a77fb": "있잖아, 요즘 나를\n잊은 거 아냐?",
 "01243bff78ae": "이제 정나미가 떨어졌어.\n맘대로 해.",
 "c5c67885bcef": "주군을 배신하는 건\n못 해.",
 "c261b1c6335b": "내가 동료를 배신할 거라고\n생각하는 거야?",
 "78fa1670757d": "싫다, 메롱메롱!",
 "7f1f01331813": "응, 좋아.\n모시고 갈게요.",
 "0dd53aeafe4c": "??\n\n주군, 탐색에\n실패해 버렸어요.",
 "02901756e8e8": "앗!!\n\n⟦V 09⟧ 씨 맞죠!\n우리한테 협력해 줘요.",
 "e9d4870075f0": "앗, 당신은!!",
 "fa26d044bfed": "내가 시로인데,\n무슨 일이야?",
 "2e739a9d2cbd": "꼭 우리 주군을\n만나 주세요.",
 "904fd9487478": "주군, ⟦V 09⟧ 씨가\n협력해 준대요!",
 "8c11d3329ada": "정말 미안한데\n다음에 하면 안 될까?",
 "1b909d975b6c": "??\n\n⟦V 0F⟧, 발견했어요!",
 "f0b073e475ee": "음, 시로라고 해요.\n도움이 되면 좋겠는데.",
 "c49a20fd5885": "주군, 성 레벨이\n1 올랐어요!",
 "507386847e65": "주군, 성 레벨이\n2나 올랐어요!",
 "0dd711870574": "에휴, 틀렸네, 이거.",
 "cd69e6ec6e12": "어이, 너희들. 다들\n잠깐 이리 와 봐.\n\n병사 보충에 성공했다고!",
 "e13050210931": "큰일이네, 이거.",
 "a9c322150d3e": "난 모른다~.",
 "13deb76ff833": "전황은 꽤\n좋은 것 같다...",
 "6f46b7eadb35": "쾌조다.\n믿어 줄지 모르겠지만...",
 "4ca9ba59c046": "보는 바와 같다...",
 "83bd004682bc": "이 세상을 살아가는 모든\n이들이 하루라도 빨리\n\n평화롭게 살 수 있는 날이\n오도록 함께 싸우자.",
 "1d2744ae2abf": "여기에는 아이템이\n있는 모양이다.",
 "11c0dc3056a6": "잠이나 잘까...",
 "461333f40279": "당장 써 보도록\n하지.",
 "38c6c467ef31": "...불만은 없지만\n편안한 것도 아니다.",
 "48ca0e2b933e": "감사히 받겠다.",
 "cc9b55da802c": "그러고 보니 요즘\n나설 일이 없군...",
 "d642a2c5635e": "자, 언제까지 행동을\n함께할 수 있을까.",
 "c35c17b1e3dc": "볼일이 없었던 모양이군.\n그럼, 이만...",
 "001f5f08c145": "이러고 있어 봐야 소용없다.\n그럼, 실례하지...",
 "54dece43295c": "미안하지만 사양하겠다.",
 "7b93d64903f4": "나라도 괜찮다면\n힘이 되어 주지...",
 "dcdd19c7aeac": "나라도 좋다면\n힘을 빌려주지...",
 "dbf43a535830": "당신은!!\n\n아무래도 사람을\n잘못 본 모양이군.",
 "3bd0a266dffb": "⟦V 09⟧ 맞지?\n\n부디 우리 군에\n참가해 주었으면 한다.",
 "870dd092dc74": "!!\n\n한참 찾았다.\n⟦V 09⟧ 맞지?",
 "58d19c4b439b": "내 이름은 ⟦V 00⟧.\n용건을 들어 보지.",
 "bec3a96967a1": "부디 ⟦V 02⟧ 님을\n알현해 주었으면 한다.",
 "ac74f50fb655": "알았다.\n당분간 따르지.",
 "52fda676a52e": "⟦V 09⟧ 녀석을\n찾아냈다.",
 "12b3e978e774": "미안하다.\n돌아가 주게.",
 "825c356cdb9b": "그거 아쉽지만\n어쩔 수 없지.",
 "38faca462f17": "으음, 이건!\n\n⟦V 0F⟧, 손에\n넣었다!!",
 "03df6049f6d6": "......\n해 보도록 하지.",
 "846e18352479": "이 정도면 충분하겠지.",
 "e04b211a0ba0": "흠, 그 공법을 써 볼까.",
 "91b6d77a81f0": "성 레벨이 1레벨\n올랐다.",
 "3332820cdb4a": "마족에게 전해지는 공법을\n써 봤다.\n\n성 레벨이 2레벨\n상승했다.",
 "78e293a2886e": "뭔가 잘 안 되는군.",
 "f6c48d82a55e": "제군, 우리 군에\n입대할 생각은 없나?\n\n병사를 보충해 두었다.",
 "65be59199c83": "역시 무리였나.",
 "8e9255d11f9d": "실패라니 꼴사납군.",
 "00c856ca3d6b": "크크크.\n쾌조다...",
 "3062dbc95b6d": "보고할 만한 일은\n아무것도 없다.",
 "9de1c079fa70": "크크크.\n......",
 "87f5fed0cb70": "여기에는...\n아이템이 있군.",
 "95855d9b055b": "......\n\n⟦V 09⟧ 맞지?\n따라와라...",
 "8e6eafad23b5": "⟦V 09⟧ 맞지?\n\n따라와라...",
 "46577b87a720": "......\n\n⟦V 09⟧ 맞지?",
 "956544bd15cb": "잠자코 따라와라.\n알겠나...",
 "bcd51437aa0e": "⟦V 09⟧ 녀석을\n데려왔습니다...",
 "997d5e4f6551": "!!\n\n⟦V 0F⟧, 손에\n넣었다...",
 "6a83870167c5": "......\n성 레벨이 1 올랐다.",
 "8ec988a8ec44": "......\n성 레벨이 2 올랐다."
}